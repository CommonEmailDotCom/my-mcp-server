# ── Required ──────────────────────────────────────────────────────────────────

# Secret token Claude.ai will send as: Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
BEARER_TOKEN=replace_with_a_strong_secret

# Absolute path to your repo on the host (mounted into the container)
REPO_PATH=/repo

# ── Optional ──────────────────────────────────────────────────────────────────

# Postgres connection string (leave blank to disable the query_postgres tool)
# Format: postgresql://user:password@host:5432/dbname
PG_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/mydb

# Port the MCP server listens on inside the container
PORT=3100
